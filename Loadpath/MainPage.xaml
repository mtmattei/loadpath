<Page x:Class="Loadpath.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="using:Loadpath.Controls"
      xmlns:v="using:Loadpath.Views"
      xmlns:w="using:Loadpath.Workspace"
      Background="{StaticResource CanvasBrush}">
  <!-- xaml-lint: allow card - banners, toast and floating bars over the drawing; the project uses no Toolkit (README decision) -->

  <Grid x:Name="Root" Background="{StaticResource CanvasBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <v:TitleStrip />

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="StructureColumn" Width="240" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="InspectorColumn" Width="336" />
      </Grid.ColumnDefinitions>

      <!-- Structure outline -->
      <Border x:Name="StructureHost" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
        <v:OutlinePanel x:Name="Outline" />
      </Border>

      <!-- Workspace host: canvas (with rulers) below, XAML overlay above. -->
      <Grid Grid.Column="1" x:Name="WorkspaceHost">
        <w:WorkspaceView x:Name="Workspace" AutomationProperties.Name="Structure workspace" />
        <c:KeySink x:Name="KeySink" />

        <!-- Floating tool palette, inside the rulers -->
        <v:ToolRail x:Name="Rail" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,40,0,0" />

        <!-- Mechanism / unsupported banner -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,0" Padding="14,8" CornerRadius="4"
                Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1"
                Visibility="{Binding Status.IsMechanism, Converter={StaticResource Vis}}" IsHitTestVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Kind="warning" Foreground="{StaticResource DangerBrush}" Width="14" Height="14" />
            <TextBlock Text="{Binding Status.MechanismText}" Style="{StaticResource BodyText}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- Detached parts notice (warning, not failure) -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,0" Padding="14,8" CornerRadius="4"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1"
                Visibility="{Binding Status.HasDetached, Converter={StaticResource Vis}}" IsHitTestVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Kind="warning" Foreground="{StaticResource InkSecondaryBrush}" Width="14" Height="14" />
            <TextBlock Text="{Binding Status.DetachedText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- Empty state -->
        <!-- A paper plate behind the text so the registration marks do not run through it. -->
        <Border x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource CanvasBrush}" Padding="32,24"
                Visibility="{Binding Status.IsEmpty, Converter={StaticResource Vis}}">
        <StackPanel Spacing="14" MaxWidth="440">
          <TextBlock Text="Fig. 00" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
          <TextBlock Text="Draw a structure and it answers." Style="{StaticResource DisplayText}" HorizontalAlignment="Center" />
          <TextBlock Style="{StaticResource SecondaryText}" TextAlignment="Center" TextWrapping="Wrap">
            <Run Text="Press" /><Run Text=" N " FontFamily="{StaticResource MonoFontMedium}" Foreground="{StaticResource InkBrush}" /><Run Text="and click to place nodes," />
            <Run Text=" M " FontFamily="{StaticResource MonoFontMedium}" Foreground="{StaticResource InkBrush}" /><Run Text="to connect them," />
            <Run Text=" S " FontFamily="{StaticResource MonoFontMedium}" Foreground="{StaticResource InkBrush}" /><Run Text="for supports and" />
            <Run Text=" L " FontFamily="{StaticResource MonoFontMedium}" Foreground="{StaticResource InkBrush}" /><Run Text="for loads. Every change re-solves instantly." />
          </TextBlock>
          <TextBlock Text="Or start from a sample" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" Margin="0,10,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Style="{StaticResource OutlineButton}" Content="Warren truss" Command="{Binding SampleWarren}" AutomationProperties.Name="Load Warren truss sample" />
            <Button Style="{StaticResource OutlineButton}" Content="Cantilever" Command="{Binding SampleCantilever}" AutomationProperties.Name="Load cantilever sample" />
            <Button Style="{StaticResource OutlineButton}" Content="Howe roof" Command="{Binding SampleRoof}" AutomationProperties.Name="Load Howe roof sample" />
          </StackPanel>
        </StackPanel>
        </Border>

        <!-- Floating selection bar, positioned by code above the selection -->
        <Border x:Name="FloatingBar" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="10,3,3,3">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <TextBlock x:Name="FloatLabel" Style="{StaticResource MonoCaption}" FontFamily="{StaticResource MonoFontMedium}" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Rectangle Width="1" Height="16" Fill="{StaticResource HairlineBrush}" Margin="0,0,4,0" />
            <Button Style="{StaticResource IconButton}" Command="{Binding CycleSupport}" ToolTipService.ToolTip="Cycle support" x:Name="FloatSupport" AutomationProperties.Name="Cycle support">
              <c:Icon Kind="support" Foreground="{StaticResource InkBrush}" />
            </Button>
            <Button Style="{StaticResource IconButton}" Command="{Binding AddLoad}" ToolTipService.ToolTip="Add 10 kN load" x:Name="FloatLoad" AutomationProperties.Name="Add load">
              <c:Icon Kind="load" Foreground="{StaticResource InkBrush}" />
            </Button>
            <Button Style="{StaticResource IconButton}" Command="{Binding SplitMember}" ToolTipService.ToolTip="Split member" x:Name="FloatSplit" AutomationProperties.Name="Split member">
              <c:Icon Kind="node" Foreground="{StaticResource InkBrush}" />
            </Button>
            <Button Style="{StaticResource IconButton}" Command="{Binding DuplicateSelection}" ToolTipService.ToolTip="Duplicate   Ctrl+D" AutomationProperties.Name="Duplicate">
              <c:Icon Kind="duplicate" Foreground="{StaticResource InkBrush}" />
            </Button>
            <Button Style="{StaticResource IconButton}" Command="{Binding DeleteSelection}" ToolTipService.ToolTip="Delete   Del" AutomationProperties.Name="Delete">
              <c:Icon Kind="delete" Foreground="{StaticResource DangerBrush}" />
            </Button>
          </StackPanel>
        </Border>

        <!-- Section drag ghost -->
        <Border x:Name="DragGhost" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3">
          <TextBlock x:Name="DragGhostText" Style="{StaticResource MonoCaption}" Foreground="{StaticResource InkBrush}" />
        </Border>

        <!-- Toast -->
        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,64" Padding="14,8" CornerRadius="4" Opacity="0" IsHitTestVisible="False"
                Background="{StaticResource InkBrush}">
          <Border.RenderTransform>
            <TranslateTransform x:Name="ToastTranslate" Y="6" />
          </Border.RenderTransform>
          <TextBlock x:Name="ToastText" Style="{StaticResource BodyText}" Foreground="{StaticResource CanvasBrush}" />
        </Border>
      </Grid>

      <!-- Inspector column -->
      <Border Grid.Column="2" x:Name="InspectorHost" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
          <v:InspectorPanel x:Name="Inspector" />
        </ScrollViewer>
      </Border>
    </Grid>

    <v:StatusBar Grid.Row="2" />

    <!-- Command palette overlay -->
    <v:CommandPalette x:Name="Palette" Grid.RowSpan="3" Visibility="{Binding IsPaletteOpen, Converter={StaticResource Vis}}" />
  </Grid>
</Page>
