<UserControl x:Class="Loadpath.Views.OutlinePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Loadpath.Controls"
             xmlns:p="using:Loadpath.Presentation">
  <UserControl.Resources>
    <DataTemplate x:Key="OutlineRow" x:DataType="p:OutlineItem">
      <Border Height="26" Padding="12,0" Background="{x:Bind c:Fmt.SelectedBrush(IsSelected), Mode=OneWay}" Tag="{x:Bind}"
              PointerPressed="OnRowPressed" PointerEntered="OnRowEntered" PointerExited="OnRowExited">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{x:Bind Label, Mode=OneWay}" Style="{StaticResource MonoCaption}" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Border Grid.Column="2" Visibility="{x:Bind c:Fmt.Vis(HasBadge), Mode=OneWay}" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind Badge, Mode=OneWay}" Style="{StaticResource MonoCaption}" FontSize="9" Foreground="{StaticResource InkSecondaryBrush}" />
          </Border>
          <TextBlock Grid.Column="3" Text="{x:Bind Value, Mode=OneWay}" Style="{StaticResource MonoCaption}" Foreground="{x:Bind c:Fmt.ForceBrush(IsTension, IsCompression, IsDanger), Mode=OneWay}" VerticalAlignment="Center" MinWidth="44" TextAlignment="Right" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowSpacing="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Padding="12,8,12,6" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
      <TextBlock Text="STRUCTURE" Style="{StaticResource SectionLabel}" />
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
      <StackPanel Padding="0,0,0,12">
        <TextBlock Text="No elements yet" Style="{StaticResource CaptionText}" Margin="12,4" Visibility="{x:Bind c:Fmt.Vis(Editor.Outline.IsEmpty), Mode=OneWay}" />
        <Border Padding="12,4" Tapped="OnToggleNodes" Visibility="{x:Bind c:Fmt.VisNot(Editor.Outline.IsEmpty), Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Kind="{x:Bind Chevron(Editor.Outline.NodesExpanded), Mode=OneWay}" Width="12" Height="12" Foreground="{StaticResource InkTertiaryBrush}" />
            <TextBlock Text="{x:Bind Editor.Outline.NodesHeader, Mode=OneWay}" Style="{StaticResource CaptionText}" Foreground="{StaticResource InkSecondaryBrush}" />
          </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{x:Bind Editor.Outline.Nodes, Mode=OneWay}" ItemTemplate="{StaticResource OutlineRow}" Visibility="{x:Bind c:Fmt.Vis(Editor.Outline.NodesExpanded), Mode=OneWay}" />
        <Border Padding="12,4" Tapped="OnToggleMembers" Visibility="{x:Bind c:Fmt.VisNot(Editor.Outline.IsEmpty), Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Kind="{x:Bind Chevron(Editor.Outline.MembersExpanded), Mode=OneWay}" Width="12" Height="12" Foreground="{StaticResource InkTertiaryBrush}" />
            <TextBlock Text="{x:Bind Editor.Outline.MembersHeader, Mode=OneWay}" Style="{StaticResource CaptionText}" Foreground="{StaticResource InkSecondaryBrush}" />
          </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{x:Bind Editor.Outline.Members, Mode=OneWay}" ItemTemplate="{StaticResource OutlineRow}" Visibility="{x:Bind c:Fmt.Vis(Editor.Outline.MembersExpanded), Mode=OneWay}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
