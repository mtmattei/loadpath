<UserControl x:Class="Loadpath.Views.OutlinePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Loadpath.Controls">
  <!-- xaml-lint: allow card - support and utilization pills, not cards; the project uses no Toolkit (README decision) -->
  <UserControl.Resources>
    <DataTemplate x:Key="OutlineRow">
      <Border Height="32" Padding="40,0,16,0" Background="{Binding RowBrushKey, Converter={StaticResource Brush}}" Tag="{Binding Key}"
              PointerPressed="OnRowPressed" PointerEntered="OnRowEntered" PointerExited="OnRowExited">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Label}" Style="{StaticResource MonoCaption}" FontFamily="{StaticResource MonoFontMedium}" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource MonoCaption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Border Grid.Column="2" Style="{StaticResource PillBorder}" Visibility="{Binding HasBadge, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding Badge}" Style="{StaticResource MonoCaption}" FontSize="10" LineHeight="14" Foreground="{StaticResource InkSecondaryBrush}" />
          </Border>
          <TextBlock Grid.Column="3" Text="{Binding Value}" Style="{StaticResource MonoCaption}" Foreground="{Binding ValueToneKey, Converter={StaticResource Brush}}" VerticalAlignment="Center" TextAlignment="Right" />
          <Border Grid.Column="4" Style="{StaticResource DangerPill}" Visibility="{Binding HasPill, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding PillText}" Style="{StaticResource MonoCaption}" FontSize="10" LineHeight="14" Foreground="{StaticResource DangerBrush}" />
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock Text="Structure" Style="{StaticResource MediumText}" Margin="16,18,16,10" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
      <StackPanel Padding="0,0,0,16">
        <TextBlock Text="No elements yet. Press N to place a node." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="16,4" Visibility="{Binding OutlineIsEmpty, Converter={StaticResource Vis}}" />

        <Button Style="{StaticResource QuietButton}" Command="{Binding ToggleNodes}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,0" Height="36"
                Visibility="{Binding OutlineIsEmpty, Converter={StaticResource Vis}, ConverterParameter=invert}" AutomationProperties.Name="Toggle nodes">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="14">
              <c:Icon Kind="chevron-down" Width="12" Height="12" Foreground="{StaticResource InkSecondaryBrush}" Visibility="{Binding NodesExpanded, Converter={StaticResource Vis}}" />
              <c:Icon Kind="chevron-right" Width="12" Height="12" Foreground="{StaticResource InkSecondaryBrush}" Visibility="{Binding NodesExpanded, Converter={StaticResource Vis}, ConverterParameter=invert}" />
            </Grid>
            <TextBlock Grid.Column="1" Text="01" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="Nodes" Style="{StaticResource MediumText}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding NodesHeader}" Style="{StaticResource MonoCaption}" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <ItemsControl ItemsSource="{Binding OutlineNodes}" ItemTemplate="{StaticResource OutlineRow}" Visibility="{Binding NodesExpanded, Converter={StaticResource Vis}}" />

        <Button Style="{StaticResource QuietButton}" Command="{Binding ToggleMembers}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,0" Height="36" Margin="0,12,0,0"
                Visibility="{Binding OutlineIsEmpty, Converter={StaticResource Vis}, ConverterParameter=invert}" AutomationProperties.Name="Toggle members">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="14">
              <c:Icon Kind="chevron-down" Width="12" Height="12" Foreground="{StaticResource InkSecondaryBrush}" Visibility="{Binding MembersExpanded, Converter={StaticResource Vis}}" />
              <c:Icon Kind="chevron-right" Width="12" Height="12" Foreground="{StaticResource InkSecondaryBrush}" Visibility="{Binding MembersExpanded, Converter={StaticResource Vis}, ConverterParameter=invert}" />
            </Grid>
            <TextBlock Grid.Column="1" Text="02" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="Members" Style="{StaticResource MediumText}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding MembersHeader}" Style="{StaticResource MonoCaption}" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <ItemsControl ItemsSource="{Binding OutlineMembers}" ItemTemplate="{StaticResource OutlineRow}" Visibility="{Binding MembersExpanded, Converter={StaticResource Vis}}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
