<UserControl x:Class="Loadpath.Views.OutlinePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Loadpath.Controls">
  <UserControl.Resources>
    <DataTemplate x:Key="OutlineRow">
      <Border Height="26" Padding="12,0" Background="{Binding RowBrushKey, Converter={StaticResource Brush}}" Tag="{Binding Key}"
              PointerPressed="OnRowPressed" PointerEntered="OnRowEntered" PointerExited="OnRowExited">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Label}" Style="{StaticResource MonoCaption}" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Border Grid.Column="2" Visibility="{Binding HasBadge, Converter={StaticResource Vis}}" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Badge}" Style="{StaticResource MonoCaption}" FontSize="9" Foreground="{StaticResource InkSecondaryBrush}" />
          </Border>
          <TextBlock Grid.Column="3" Text="{Binding Value}" Style="{StaticResource MonoCaption}" Foreground="{Binding ValueToneKey, Converter={StaticResource Brush}}" VerticalAlignment="Center" MinWidth="44" TextAlignment="Right" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Padding="12,8,12,6" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
      <TextBlock Text="STRUCTURE" Style="{StaticResource SectionLabel}" />
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
      <StackPanel Padding="0,0,0,12">
        <TextBlock Text="No elements yet" Style="{StaticResource CaptionText}" Margin="12,4" Visibility="{Binding OutlineIsEmpty, Converter={StaticResource Vis}}" />
        <Button Style="{StaticResource QuietButton}" Command="{Binding ToggleNodes}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,0" Height="24"
                Visibility="{Binding OutlineIsEmpty, Converter={StaticResource Vis}, ConverterParameter=invert}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Kind="chevron-down" Width="12" Height="12" Foreground="{StaticResource InkTertiaryBrush}" Visibility="{Binding NodesExpanded, Converter={StaticResource Vis}}" />
            <c:Icon Kind="chevron-right" Width="12" Height="12" Foreground="{StaticResource InkTertiaryBrush}" Visibility="{Binding NodesExpanded, Converter={StaticResource Vis}, ConverterParameter=invert}" />
            <TextBlock Text="{Binding NodesHeader}" Style="{StaticResource CaptionText}" Foreground="{StaticResource InkSecondaryBrush}" />
          </StackPanel>
        </Button>
        <ItemsControl ItemsSource="{Binding OutlineNodes}" ItemTemplate="{StaticResource OutlineRow}" Visibility="{Binding NodesExpanded, Converter={StaticResource Vis}}" />
        <Button Style="{StaticResource QuietButton}" Command="{Binding ToggleMembers}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,0" Height="24"
                Visibility="{Binding OutlineIsEmpty, Converter={StaticResource Vis}, ConverterParameter=invert}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Kind="chevron-down" Width="12" Height="12" Foreground="{StaticResource InkTertiaryBrush}" Visibility="{Binding MembersExpanded, Converter={StaticResource Vis}}" />
            <c:Icon Kind="chevron-right" Width="12" Height="12" Foreground="{StaticResource InkTertiaryBrush}" Visibility="{Binding MembersExpanded, Converter={StaticResource Vis}, ConverterParameter=invert}" />
            <TextBlock Text="{Binding MembersHeader}" Style="{StaticResource CaptionText}" Foreground="{StaticResource InkSecondaryBrush}" />
          </StackPanel>
        </Button>
        <ItemsControl ItemsSource="{Binding OutlineMembers}" ItemTemplate="{StaticResource OutlineRow}" Visibility="{Binding MembersExpanded, Converter={StaticResource Vis}}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
