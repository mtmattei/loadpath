<UserControl x:Class="Loadpath.Views.TitleStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Loadpath.Controls"
             Height="56">
  <!-- xaml-lint: allow card - status pill and keycap, not cards; the project uses no Toolkit (README decision) -->
  <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="16,0,12,0">
    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left: wordmark, document, history -->
      <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
        <TextBlock Text="Loadpath" Style="{StaticResource TitleText}" FontSize="16" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Status.DocumentName}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="-6,0,0,0"
                    Visibility="{Binding Status.IsDirty, Converter={StaticResource Vis}}">
          <Ellipse Width="5" Height="5" Fill="{StaticResource InkSecondaryBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Unsaved" Style="{StaticResource MonoCaption}" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Style="{StaticResource IconButton}" Command="{Binding Undo}" ToolTipService.ToolTip="{Binding Status.UndoTooltip}" AutomationProperties.Name="Undo">
            <c:Icon Kind="undo" Foreground="{StaticResource InkBrush}" />
          </Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding Redo}" ToolTipService.ToolTip="{Binding Status.RedoTooltip}" AutomationProperties.Name="Redo">
            <c:Icon Kind="redo" Foreground="{StaticResource InkBrush}" />
          </Button>
        </StackPanel>
      </StackPanel>

      <!-- Center: display mode -->
      <Border Grid.Column="1" Style="{StaticResource SegmentGroup}" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <ToggleButton Style="{StaticResource SegmentToggle}" Content="Forces" IsChecked="{Binding IsForces}" Command="{Binding ShowForces}"
                        ToolTipService.ToolTip="Show axial forces   1" AutomationProperties.Name="Show forces" />
          <Rectangle Width="1" Fill="{StaticResource InkSecondaryBrush}" />
          <ToggleButton Style="{StaticResource SegmentToggle}" Content="Utilization" IsChecked="{Binding IsUtilization}" Command="{Binding ShowUtilization}"
                        ToolTipService.ToolTip="Show utilization   2" AutomationProperties.Name="Show utilization" />
        </StackPanel>
      </Border>

      <!-- Right: status pill, commands, files -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Border Height="30" CornerRadius="15" Padding="12,0" BorderThickness="1" VerticalAlignment="Center"
                Background="{Binding Status.PillIsDanger, Converter={StaticResource Pick}, ConverterParameter=DangerSoftBrush|SurfaceRaisedBrush}"
                BorderBrush="{Binding Status.PillIsDanger, Converter={StaticResource Pick}, ConverterParameter=DangerBorderBrush|HairlineBrush}">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <c:Icon Kind="warning" Width="14" Height="14" Foreground="{StaticResource DangerBrush}"
                    Visibility="{Binding Status.PillIsDanger, Converter={StaticResource Vis}}" />
            <Ellipse Width="6" Height="6" Fill="{Binding Status.StatusToneKey, Converter={StaticResource Brush}}" VerticalAlignment="Center"
                     Visibility="{Binding Status.PillIsDanger, Converter={StaticResource Vis}, ConverterParameter=invert}" />
            <TextBlock Text="{Binding Status.PillText}" Style="{StaticResource MediumText}" VerticalAlignment="Center"
                       Foreground="{Binding Status.PillIsDanger, Converter={StaticResource Pick}, ConverterParameter=DangerBrush|InkSecondaryBrush}" />
          </StackPanel>
        </Border>

        <Button Style="{StaticResource OutlineButton}" Height="38" Padding="10,0,4,0" Command="{Binding TogglePalette}"
                ToolTipService.ToolTip="Command palette   Ctrl+K" AutomationProperties.Name="Command palette">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Kind="search" Width="14" Height="14" Foreground="{StaticResource InkSecondaryBrush}" />
            <TextBlock Text="Commands" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,14,0" />
            <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="3" Padding="6,1">
              <StackPanel>
                <TextBlock Text="Ctrl" Style="{StaticResource MonoCaption}" FontSize="10" LineHeight="12" HorizontalAlignment="Center" />
                <TextBlock Text="K" Style="{StaticResource MonoCaption}" FontSize="10" LineHeight="12" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource LinkButton}" Content="Open" Command="{Binding OpenFile}" ToolTipService.ToolTip="Open   Ctrl+O" AutomationProperties.Name="Open" />
        <Button Style="{StaticResource PrimaryButton}" Content="Save" Command="{Binding SaveFile}" ToolTipService.ToolTip="Save   Ctrl+S" AutomationProperties.Name="Save" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
