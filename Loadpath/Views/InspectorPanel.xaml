<UserControl x:Class="Loadpath.Views.InspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Loadpath.Controls"
             x:Name="Panel">
  <UserControl.Resources>
    <Style x:Key="Row" TargetType="Grid">
      <Setter Property="Height" Value="28" />
      <Setter Property="ColumnSpacing" Value="8" />
    </Style>
  </UserControl.Resources>

  <StackPanel Padding="12,10,12,12" Spacing="0">
    <TextBlock Text="{Binding Inspector.Title}" Style="{StaticResource TitleText}" />
    <TextBlock Text="{Binding Inspector.Subtitle}" Style="{StaticResource SecondaryText}" Margin="0,2,0,12" />

    <!-- ===== Summary ===== -->
    <StackPanel Visibility="{Binding Inspector.IsSummary, Converter={StaticResource Vis}}" Spacing="0">
      <Grid Style="{StaticResource Row}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Nodes" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Inspector.NodeCountText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
      </Grid>
      <Grid Style="{StaticResource Row}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Members" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Inspector.MemberCountText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
      </Grid>
      <Grid Style="{StaticResource Row}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Supports" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Inspector.SupportsText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
      </Grid>
      <Grid Style="{StaticResource Row}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Applied load" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Inspector.TotalLoadText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
      </Grid>
      <Grid Style="{StaticResource Row}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Steel mass" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Inspector.MassText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
      </Grid>

      <TextBlock Text="RESULT" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
      <Grid Style="{StaticResource Row}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Max utilization" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Inspector.MaxUtilText}" Style="{StaticResource ValueText}" Foreground="{Binding Inspector.MaxUtilToneKey, Converter={StaticResource Brush}}" VerticalAlignment="Center" />
      </Grid>
      <c:UtilizationBar Value="{Binding Inspector.MaxUtil}" Foreground="{Binding Inspector.MaxUtilToneKey, Converter={StaticResource Brush}}" Margin="0,0,0,8" />
      <Grid Style="{StaticResource Row}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Max deflection" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Inspector.MaxDeflectionText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
      </Grid>
      <Button Style="{StaticResource OutlineButton}" Command="{Binding JumpToCritical}" HorizontalAlignment="Stretch" Margin="0,6,0,0"
              Visibility="{Binding Inspector.HasCritical, Converter={StaticResource Vis}}" AutomationProperties.Name="Jump to critical member">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <c:Icon Kind="target" Width="14" Height="14" />
          <TextBlock Text="{Binding Inspector.CriticalText}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <TextBlock Text="REACTIONS" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" Visibility="{Binding Inspector.ReactionsText, Converter={StaticResource VisText}}" />
      <TextBlock Text="{Binding Inspector.ReactionsText}" Style="{StaticResource MonoCaption}" Foreground="{StaticResource InkSecondaryBrush}" LineHeight="18" Visibility="{Binding Inspector.ReactionsText, Converter={StaticResource VisText}}" />

      <TextBlock Text="{Binding Inspector.SummaryHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,16,0,0" />
    </StackPanel>

    <!-- ===== Node ===== -->
    <StackPanel Visibility="{Binding Inspector.IsNode, Converter={StaticResource Vis}}" Spacing="0">
      <TextBlock Text="POSITION" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Text="x" Style="{StaticResource MonoCaption}" VerticalAlignment="Center" />
        <c:NumberField Grid.Column="1" Value="{Binding NodeX, Mode=TwoWay}" Unit="m" Decimals="3" Step="0.5" AutomationProperties.Name="Node X" />
        <TextBlock Grid.Column="2" Text="y" Style="{StaticResource MonoCaption}" VerticalAlignment="Center" />
        <c:NumberField Grid.Column="3" Value="{Binding NodeY, Mode=TwoWay}" Unit="m" Decimals="3" Step="0.5" AutomationProperties.Name="Node Y" />
      </Grid>

      <TextBlock Text="SUPPORT" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
      <StackPanel Orientation="Horizontal" Spacing="2">
        <ToggleButton Style="{StaticResource SegmentToggle}" Content="None" IsChecked="{Binding Inspector.IsFree}" Command="{Binding SupportNone}" />
        <ToggleButton Style="{StaticResource SegmentToggle}" Content="Pin" IsChecked="{Binding Inspector.IsPin}" Command="{Binding SupportPin}" />
        <ToggleButton Style="{StaticResource SegmentToggle}" Content="Roller" IsChecked="{Binding Inspector.IsRoller}" Command="{Binding SupportRoller}" />
        <ToggleButton Style="{StaticResource SegmentToggle}" Content="Roller ↕" IsChecked="{Binding Inspector.IsRollerX}" Command="{Binding SupportRollerX}" ToolTipService.ToolTip="Fixed in X, free in Y" />
      </StackPanel>
      <Grid Style="{StaticResource Row}" Visibility="{Binding Inspector.HasReaction, Converter={StaticResource Vis}}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Reaction" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Inspector.ReactionText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
      </Grid>

      <TextBlock Text="LOAD" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Text="Fx" Style="{StaticResource MonoCaption}" VerticalAlignment="Center" />
        <c:NumberField Grid.Column="1" Value="{Binding LoadX, Mode=TwoWay}" Unit="kN" Decimals="1" Step="1" AutomationProperties.Name="Load X" />
        <TextBlock Grid.Column="2" Text="Fy" Style="{StaticResource MonoCaption}" VerticalAlignment="Center" />
        <c:NumberField Grid.Column="3" Value="{Binding LoadY, Mode=TwoWay}" Unit="kN" Decimals="1" Step="1" AutomationProperties.Name="Load Y" />
      </Grid>
      <TextBlock Text="Negative Fy is downward. Drag the arrow tail on the canvas to aim it." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0" />

      <TextBlock Text="CONNECTED" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
      <TextBlock Text="{Binding Inspector.ConnectedText}" Style="{StaticResource MonoCaption}" Foreground="{StaticResource InkSecondaryBrush}" TextWrapping="Wrap" />
      <Grid Style="{StaticResource Row}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Displacement" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Inspector.DisplacementText}" Style="{StaticResource MonoCaption}" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
      </Grid>
    </StackPanel>

    <!-- ===== Member ===== -->
    <StackPanel Visibility="{Binding Inspector.IsMember, Converter={StaticResource Vis}}" Spacing="0">
      <Grid Style="{StaticResource Row}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Endpoints" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Inspector.EndpointsText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
      </Grid>
      <Grid Style="{StaticResource Row}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Length" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Inspector.LengthText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
      </Grid>

      <TextBlock Text="SECTION" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
      <ComboBox ItemsSource="{Binding Sections}" SelectedIndex="{Binding SectionIndex, Mode=TwoWay}"
                HorizontalAlignment="Stretch" MinHeight="26" Height="28" FontFamily="{StaticResource UiFont}" FontSize="12" AutomationProperties.Name="Section">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource UiFont}" FontSize="12" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="{Binding Inspector.MaterialText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0" />
      <TextBlock Text="{Binding Inspector.AreaText}" Style="{StaticResource MonoCaption}" Margin="0,2,0,0" />
      <TextBlock Text="Drag a section from the list below onto any member." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0" />
      <ItemsControl ItemsSource="{Binding Sections}" Margin="0,6,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Tag="{Binding Id}"
                    PointerPressed="OnSectionChipPressed" ToolTipService.ToolTip="{Binding Name}">
              <TextBlock Text="{Binding ShortName}" Style="{StaticResource MonoCaption}" Foreground="{StaticResource InkSecondaryBrush}" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="RESULT" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
      <Grid Style="{StaticResource Row}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Inspector.ForceKindText}" Style="{StaticResource MediumText}" Foreground="{Binding Inspector.ForceToneKey, Converter={StaticResource Brush}}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Inspector.ForceText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
      </Grid>
      <Grid Style="{StaticResource Row}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Stress" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Inspector.StressText}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
      </Grid>
      <Grid Style="{StaticResource Row}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Utilization" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Inspector.UtilText}" Style="{StaticResource ValueText}" Foreground="{Binding Inspector.UtilToneKey, Converter={StaticResource Brush}}" VerticalAlignment="Center" />
      </Grid>
      <c:UtilizationBar Value="{Binding Inspector.Util}" Foreground="{Binding Inspector.UtilToneKey, Converter={StaticResource Brush}}" />
      <TextBlock Text="{Binding Inspector.GovernsText}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
      <Grid Style="{StaticResource Row}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Buckling" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Inspector.BucklingText}" Style="{StaticResource MonoCaption}" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,12,0,0">
        <Button Style="{StaticResource OutlineButton}" Command="{Binding SplitMember}" Content="Split at midpoint" />
      </StackPanel>
    </StackPanel>

    <!-- ===== Mixed ===== -->
    <StackPanel Visibility="{Binding Inspector.IsMixed, Converter={StaticResource Vis}}" Spacing="8">
      <TextBlock Text="{Binding Inspector.MixedText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
      <StackPanel Spacing="4" Visibility="{Binding Inspector.MixedHasNodes, Converter={StaticResource Vis}}">
        <TextBlock Text="NODES" Style="{StaticResource SectionLabel}" Margin="0,8,0,2" />
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Style="{StaticResource OutlineButton}" Content="Pin" Command="{Binding SupportPin}" />
          <Button Style="{StaticResource OutlineButton}" Content="Roller" Command="{Binding SupportRoller}" />
          <Button Style="{StaticResource OutlineButton}" Content="No support" Command="{Binding SupportNone}" />
        </StackPanel>
        <Button Style="{StaticResource OutlineButton}" Content="Clear loads" Command="{Binding ClearLoads}" />
      </StackPanel>
      <StackPanel Spacing="4" Visibility="{Binding Inspector.MixedHasMembers, Converter={StaticResource Vis}}">
        <TextBlock Text="MEMBERS · SET SECTION" Style="{StaticResource SectionLabel}" Margin="0,8,0,2" />
        <ItemsControl ItemsSource="{Binding Sections}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      Command="{Binding DataContext.ApplySection, ElementName=Panel}" CommandParameter="{Binding Id}">
                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <Button Style="{StaticResource OutlineButton}" Content="Delete selection" Command="{Binding DeleteSelection}" Margin="0,8,0,0" />
    </StackPanel>
  </StackPanel>
</UserControl>
