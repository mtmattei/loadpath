<UserControl x:Class="Loadpath.Views.CommandPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Loadpath.Controls"
             xmlns:p="using:Loadpath.Presentation">
  <Grid x:Name="Scrim" Background="#66000000" PointerPressed="OnScrimPressed">
    <Border x:Name="Panel" Width="520" MaxHeight="420" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,96,0,0"
            Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1" CornerRadius="6"
            PointerPressed="OnPanelPressed">
      <Border.RenderTransform>
        <TranslateTransform x:Name="PanelTranslate" Y="0" />
      </Border.RenderTransform>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Padding="8,0" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" ColumnSpacing="4">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <c:Icon Kind="search" Width="14" Height="14" Margin="4,0,0,0" />
          <TextBox x:Name="Query" Grid.Column="1" Style="{StaticResource SearchTextBox}" PlaceholderText="Type a command…" TextChanged="OnQueryChanged" KeyDown="OnQueryKeyDown" AutomationProperties.Name="Command search" />
        </Grid>
        <ScrollViewer Grid.Row="1" x:Name="ListScroll" VerticalScrollBarVisibility="Auto" MaxHeight="340">
          <ItemsControl x:Name="List" ItemsSource="{x:Bind Items, Mode=OneWay}" Padding="4">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="p:PaletteItem">
                <Border Height="28" Padding="8,0" CornerRadius="4" Background="{x:Bind c:Fmt.SelectedBrush(IsHighlighted), Mode=OneWay}" Tag="{x:Bind}" PointerPressed="OnItemPressed" PointerEntered="OnItemEntered">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:Icon Kind="{x:Bind Icon}" Width="14" Height="14" Visibility="{x:Bind HasIcon}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Opacity="{x:Bind c:Fmt.DimIf(IsDisabled)}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Category}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{x:Bind Shortcut}" Style="{StaticResource MonoCaption}" VerticalAlignment="Center" MinWidth="56" TextAlignment="Right" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Border Grid.Row="2" Padding="12,6" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
          <TextBlock Text="↑↓ navigate · Enter run · Esc close" Style="{StaticResource CaptionText}" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
