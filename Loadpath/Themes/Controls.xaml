<!-- Control styles. Every interactive element: Normal / PointerOver / Pressed / Disabled, plus visible keyboard focus. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Loadpath.Controls">

  <!-- ===== Text ===== -->
  <Style x:Key="BodyText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="LineHeight" Value="17" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
  </Style>
  <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontSize" Value="{StaticResource TextCaption}" />
    <Setter Property="LineHeight" Value="15" />
    <Setter Property="Foreground" Value="{StaticResource InkTertiaryBrush}" />
  </Style>
  <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontFamily" Value="{StaticResource UiFontMedium}" />
    <Setter Property="FontSize" Value="{StaticResource TextCaption}" />
    <Setter Property="Foreground" Value="{StaticResource InkTertiaryBrush}" />
    <Setter Property="LineHeight" Value="15" />
  </Style>
  <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontFamily" Value="{StaticResource UiFontSemiBold}" />
    <Setter Property="FontSize" Value="{StaticResource TextTitle}" />
    <Setter Property="LineHeight" Value="20" />
  </Style>
  <Style x:Key="MediumText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontFamily" Value="{StaticResource UiFontMedium}" />
  </Style>
  <Style x:Key="ValueText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="{StaticResource TextValue}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="LineHeight" Value="17" />
  </Style>
  <Style x:Key="MonoCaption" TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
    <Setter Property="FontSize" Value="{StaticResource TextCaption}" />
    <Setter Property="LineHeight" Value="15" />
    <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
  </Style>

  <!-- ===== Buttons ===== -->
  <Style x:Key="QuietButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="IsTabStop" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="RootScale" />
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource DurationFast}" />
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource DurationFast}" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Chrome.Background" Value="{StaticResource SurfaceHoverBrush}" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource DurationFast}" />
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource DurationFast}" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Chrome.Background" Value="{StaticResource SurfaceRaisedBrush}" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="{StaticResource PressScale}" Duration="{StaticResource DurationFast}" />
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="{StaticResource PressScale}" Duration="{StaticResource DurationFast}" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Unfocused" />
                <VisualState x:Name="PointerFocused" />
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="FocusRing.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource RadiusField}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter x:Name="ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <Border x:Name="FocusRing" Opacity="0" IsHitTestVisible="False" Margin="-2"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="6" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFontMedium}" />
    <Setter Property="Padding" Value="12,0" />
  </Style>

  <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="Padding" Value="10,0" />
  </Style>

  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
  </Style>

  <!-- Tool rail button: 32 px, icon follows Foreground, accent bar on the left when active. -->
  <Style TargetType="c:ToolButton">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="IsTabStop" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:ToolButton">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="RootScale" />
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource DurationFast}" />
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource DurationFast}" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Chrome.Background" Value="{StaticResource SurfaceHoverBrush}" />
                    <Setter Target="Glyph.Foreground" Value="{StaticResource InkBrush}" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource DurationFast}" />
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource DurationFast}" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Chrome.Background" Value="{StaticResource SurfaceRaisedBrush}" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="{StaticResource PressScale}" Duration="{StaticResource DurationFast}" />
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="{StaticResource PressScale}" Duration="{StaticResource DurationFast}" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="ActiveStates">
                <VisualState x:Name="Inactive" />
                <VisualState x:Name="Active">
                  <VisualState.Setters>
                    <Setter Target="Chrome.Background" Value="{StaticResource SurfaceRaisedBrush}" />
                    <Setter Target="Glyph.Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter Target="ActiveBar.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Unfocused" />
                <VisualState x:Name="PointerFocused" />
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="FocusRing.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusField}">
              <c:Icon x:Name="Glyph" Kind="{TemplateBinding IconKind}" Foreground="{TemplateBinding Foreground}" Width="16" Height="16" />
            </Border>
            <Rectangle x:Name="ActiveBar" Opacity="0" Width="2" Height="16" RadiusX="1" RadiusY="1"
                       Fill="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-6,0,0,0" />
            <Border x:Name="FocusRing" Opacity="0" IsHitTestVisible="False" Margin="-2"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="6" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segment toggle: used for support kind and display modes. -->
  <Style x:Key="SegmentToggle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Chrome.Background" Value="{StaticResource SurfaceHoverBrush}" />
                    <Setter Target="Label.Foreground" Value="{StaticResource InkBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Chrome.Background" Value="{StaticResource SurfaceHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Chrome.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Chrome.Background" Value="{StaticResource SurfaceHoverBrush}" />
                    <Setter Target="Label.Foreground" Value="{StaticResource InkBrush}" />
                    <Setter Target="Chrome.BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Chrome.Background" Value="{StaticResource SurfaceHoverBrush}" />
                    <Setter Target="Label.Foreground" Value="{StaticResource InkBrush}" />
                    <Setter Target="Chrome.BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="Chrome.Background" Value="{StaticResource SurfaceHoverBrush}" />
                    <Setter Target="Label.Foreground" Value="{StaticResource InkBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedDisabled">
                  <VisualState.Setters>
                    <Setter Target="Chrome.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Unfocused" />
                <VisualState x:Name="PointerFocused" />
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="FocusRing.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusField}" Padding="{TemplateBinding Padding}">
              <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="FocusRing" Opacity="0" IsHitTestVisible="False" Margin="-2"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="6" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Numeric field: mono value, unit suffix supplied by the NumberField control around it. -->
  <Style x:Key="FieldTextBox" TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="{StaticResource TextValue}" />
    <Setter Property="Padding" Value="6,3,6,3" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="SelectionHighlightColor" Value="{StaticResource AccentBrush}" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Chrome.BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="Chrome.BorderBrush" Value="{StaticResource AccentBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Chrome.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusField}">
              <ScrollViewer x:Name="ContentElement"
                            HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                            IsTabStop="False" ZoomMode="Disabled"
                            Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SearchTextBox" TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource TextValue}" />
    <Setter Property="TextAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="8,0" />
  </Style>

  <!-- ===== Menus, tooltips ===== -->
  <Style TargetType="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPopover}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinWidth" Value="180" />
  </Style>

  <Style TargetType="MenuFlyoutItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuFlyoutItem">
          <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusField}" Padding="{TemplateBinding Padding}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="LayoutRoot.Background" Value="{StaticResource SurfaceHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="LayoutRoot.Background" Value="{StaticResource SurfaceHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="LayoutRoot.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="TextBlock" Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}"
                         FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" />
              <TextBlock x:Name="KeyboardAcceleratorTextBlock" Grid.Column="1" Text="{TemplateBinding KeyboardAcceleratorTextOverride}"
                         Style="{StaticResource MonoCaption}" Foreground="{StaticResource InkTertiaryBrush}" VerticalAlignment="Center" />
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuFlyoutSeparator">
    <Setter Property="Background" Value="{StaticResource HairlineBrush}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="4,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuFlyoutSeparator">
          <Rectangle Fill="{TemplateBinding Background}" Height="1" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource TextCaption}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusField}" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Compact slider: 2 px track, 10 px thumb. -->
  <Style x:Key="CompactSlider" TargetType="Slider">
    <Setter Property="Background" Value="{StaticResource HairlineStrongBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
    <Setter Property="Height" Value="20" />
    <Setter Property="MinWidth" Value="60" />
    <Setter Property="IsThumbToolTipEnabled" Value="False" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid x:Name="SliderContainer" Background="Transparent">
            <Grid x:Name="HorizontalTemplate" Height="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Rectangle x:Name="HorizontalTrackRect" Grid.ColumnSpan="3" Height="2" Fill="{TemplateBinding Background}" VerticalAlignment="Center" RadiusX="1" RadiusY="1" />
              <Rectangle x:Name="HorizontalDecreaseRect" Height="2" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center" RadiusX="1" RadiusY="1" />
              <Thumb x:Name="HorizontalThumb" Grid.Column="1" Width="10" Height="10" AutomationProperties.AccessibilityView="Raw">
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource InkBrush}" />
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- NumberField: mono value + unit suffix. -->
  <Style TargetType="c:NumberField">
    <Setter Property="Height" Value="26" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:NumberField">
          <Grid>
            <TextBox x:Name="PART_Box" Style="{StaticResource FieldTextBox}" Padding="6,3,30,3" />
            <TextBlock Text="{TemplateBinding Unit}" Style="{StaticResource MonoCaption}" Foreground="{StaticResource InkTertiaryBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" IsHitTestVisible="False" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- UtilizationBar: 4 px track, fill scaled by Value. -->
  <Style TargetType="c:UtilizationBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:UtilizationBar">
          <Grid>
            <Rectangle Fill="{StaticResource HairlineStrongBrush}" RadiusX="2" RadiusY="2" />
            <Rectangle Fill="{TemplateBinding Foreground}" RadiusX="2" RadiusY="2" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
              <Rectangle.RenderTransform>
                <ScaleTransform ScaleX="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}" />
              </Rectangle.RenderTransform>
            </Rectangle>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
