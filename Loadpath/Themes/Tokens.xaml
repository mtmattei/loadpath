<!--
  Loadpath design tokens. Every color, brush, font and size in the app comes from here.
  Single dark theme: a plain root-level dictionary (custom keys in ThemeDictionaries resolve unreliably on Uno).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Color roles -->
  <Color x:Key="CanvasColor">#0F1216</Color>
  <Color x:Key="SurfaceColor">#151A20</Color>
  <Color x:Key="SurfaceRaisedColor">#1B212A</Color>
  <Color x:Key="SurfaceHoverColor">#20272F</Color>
  <Color x:Key="HairlineColor">#12FFFFFF</Color>
  <Color x:Key="HairlineStrongColor">#22FFFFFF</Color>
  <Color x:Key="InkColor">#E7EBF0</Color>
  <Color x:Key="InkSecondaryColor">#98A2B3</Color>
  <Color x:Key="InkTertiaryColor">#5F6B7A</Color>
  <Color x:Key="AccentColor">#7DB1FF</Color>
  <Color x:Key="AccentSoftColor">#267DB1FF</Color>
  <Color x:Key="AccentInkColor">#0B1220</Color>
  <Color x:Key="TensionColor">#D9924A</Color>
  <Color x:Key="CompressionColor">#5D9AD6</Color>
  <Color x:Key="NeutralMemberColor">#8791A0</Color>
  <Color x:Key="DangerColor">#F25F5C</Color>
  <Color x:Key="DangerSoftColor">#26F25F5C</Color>
  <Color x:Key="OkColor">#4FB286</Color>
  <Color x:Key="GroundColor">#3A424D</Color>
  <Color x:Key="ShadowColor">#3D000000</Color>

  <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
  <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
  <SolidColorBrush x:Key="HairlineStrongBrush" Color="{StaticResource HairlineStrongColor}" />
  <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="InkSecondaryBrush" Color="{StaticResource InkSecondaryColor}" />
  <SolidColorBrush x:Key="InkTertiaryBrush" Color="{StaticResource InkTertiaryColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
  <SolidColorBrush x:Key="AccentInkBrush" Color="{StaticResource AccentInkColor}" />
  <SolidColorBrush x:Key="TensionBrush" Color="{StaticResource TensionColor}" />
  <SolidColorBrush x:Key="CompressionBrush" Color="{StaticResource CompressionColor}" />
  <SolidColorBrush x:Key="NeutralMemberBrush" Color="{StaticResource NeutralMemberColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
  <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
  <SolidColorBrush x:Key="GroundBrush" Color="{StaticResource GroundColor}" />
  <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

  <!-- Type: Inter for UI, JetBrains Mono for every number. Static instances; the Skia text stack ignores wght axes. -->
  <FontFamily x:Key="UiFont">ms-appx:///Assets/Fonts/Inter-Regular.ttf#Inter</FontFamily>
  <FontFamily x:Key="UiFontMedium">ms-appx:///Assets/Fonts/Inter-Medium.ttf#Inter Medium</FontFamily>
  <FontFamily x:Key="UiFontSemiBold">ms-appx:///Assets/Fonts/Inter-SemiBold.ttf#Inter SemiBold</FontFamily>
  <FontFamily x:Key="MonoFont">ms-appx:///Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>
  <FontFamily x:Key="MonoFontMedium">ms-appx:///Assets/Fonts/JetBrainsMono-Medium.ttf#JetBrains Mono Medium</FontFamily>

  <x:Double x:Key="TextCaption">11</x:Double>
  <x:Double x:Key="TextBody">12</x:Double>
  <x:Double x:Key="TextValue">13</x:Double>
  <x:Double x:Key="TextTitle">15</x:Double>

  <!-- Spacing and sizes (4 px base) -->
  <x:Double x:Key="Space1">4</x:Double>
  <x:Double x:Key="Space2">8</x:Double>
  <x:Double x:Key="Space3">12</x:Double>
  <x:Double x:Key="Space4">16</x:Double>
  <x:Double x:Key="RowHeight">28</x:Double>
  <x:Double x:Key="FieldHeight">26</x:Double>
  <x:Double x:Key="ToolButtonSize">32</x:Double>
  <x:Double x:Key="ToolRailWidth">40</x:Double>
  <x:Double x:Key="TitleStripHeight">36</x:Double>
  <x:Double x:Key="StatusBarHeight">26</x:Double>
  <x:Double x:Key="InspectorWidth">280</x:Double>
  <Thickness x:Key="PanelPadding">12</Thickness>

  <CornerRadius x:Key="RadiusField">4</CornerRadius>
  <CornerRadius x:Key="RadiusPopover">6</CornerRadius>
</ResourceDictionary>
