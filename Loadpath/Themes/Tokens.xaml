<!--
  Loadpath design tokens. Every color, brush, font and size in the app comes from here.
  Single light "drafting sheet" theme: a plain root-level dictionary (custom keys in ThemeDictionaries resolve unreliably on Uno).
  Ink is near-black; force sign is carried by line style (solid tension, hatched compression), not by color.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- xaml-lint: allow tokentheme - deliberate single light theme; App.xaml pins RequestedTheme="Light" -->
  <!-- Color roles -->
  <Color x:Key="CanvasColor">#FFFFFF</Color>
  <Color x:Key="SurfaceColor">#FFFFFF</Color>
  <Color x:Key="SurfaceRaisedColor">#F6F7F9</Color>
  <Color x:Key="SurfaceHoverColor">#F1F2F5</Color>
  <Color x:Key="SelectionColor">#E9ECFB</Color>
  <Color x:Key="HairlineColor">#E4E6EA</Color>
  <Color x:Key="HairlineStrongColor">#C9CDD4</Color>
  <Color x:Key="InkColor">#15171A</Color>
  <Color x:Key="InkSecondaryColor">#4D535C</Color>
  <Color x:Key="InkTertiaryColor">#8B919A</Color>
  <Color x:Key="AccentColor">#2D46D6</Color>
  <Color x:Key="AccentSoftColor">#E9ECFB</Color>
  <Color x:Key="AccentBorderColor">#AEB8EE</Color>
  <Color x:Key="AccentInkColor">#FFFFFF</Color>
  <Color x:Key="TensionColor">#15171A</Color>
  <Color x:Key="CompressionColor">#15171A</Color>
  <Color x:Key="NeutralMemberColor">#8B919A</Color>
  <Color x:Key="WarnColor">#A86A12</Color>
  <Color x:Key="DangerColor">#D42A2A</Color>
  <Color x:Key="DangerSoftColor">#FCE6E6</Color>
  <Color x:Key="DangerBorderColor">#F2B8B8</Color>
  <Color x:Key="OkColor">#4D535C</Color>
  <Color x:Key="GroundColor">#15171A</Color>
  <Color x:Key="ShadowColor">#1A15171A</Color>

  <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
  <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
  <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
  <SolidColorBrush x:Key="HairlineStrongBrush" Color="{StaticResource HairlineStrongColor}" />
  <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="InkSecondaryBrush" Color="{StaticResource InkSecondaryColor}" />
  <SolidColorBrush x:Key="InkTertiaryBrush" Color="{StaticResource InkTertiaryColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
  <SolidColorBrush x:Key="AccentBorderBrush" Color="{StaticResource AccentBorderColor}" />
  <SolidColorBrush x:Key="AccentInkBrush" Color="{StaticResource AccentInkColor}" />
  <SolidColorBrush x:Key="TensionBrush" Color="{StaticResource TensionColor}" />
  <SolidColorBrush x:Key="CompressionBrush" Color="{StaticResource CompressionColor}" />
  <SolidColorBrush x:Key="NeutralMemberBrush" Color="{StaticResource NeutralMemberColor}" />
  <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
  <SolidColorBrush x:Key="DangerBorderBrush" Color="{StaticResource DangerBorderColor}" />
  <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
  <SolidColorBrush x:Key="GroundBrush" Color="{StaticResource GroundColor}" />
  <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
  <!-- Hover wash laid over any fill: darkens white chrome and the accent button alike. -->
  <SolidColorBrush x:Key="HoverWashBrush" Color="#0D15171A" />

  <!-- Type: Inter for UI, JetBrains Mono for every number. Static instances; the Skia text stack ignores wght axes. -->
  <FontFamily x:Key="UiFont">ms-appx:///Assets/Fonts/Inter-Regular.ttf#Inter</FontFamily>
  <FontFamily x:Key="UiFontMedium">ms-appx:///Assets/Fonts/Inter-Medium.ttf#Inter Medium</FontFamily>
  <FontFamily x:Key="UiFontSemiBold">ms-appx:///Assets/Fonts/Inter-SemiBold.ttf#Inter SemiBold</FontFamily>
  <FontFamily x:Key="MonoFont">ms-appx:///Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>
  <FontFamily x:Key="MonoFontMedium">ms-appx:///Assets/Fonts/JetBrainsMono-Medium.ttf#JetBrains Mono Medium</FontFamily>

  <x:Double x:Key="TextCaption">11</x:Double>
  <x:Double x:Key="TextBody">13</x:Double>
  <x:Double x:Key="TextValue">13</x:Double>
  <x:Double x:Key="TextTitle">15</x:Double>
  <x:Double x:Key="TextDisplay">22</x:Double>

  <!-- Spacing and sizes (4 px base) -->
  <x:Double x:Key="Space1">4</x:Double>
  <x:Double x:Key="Space2">8</x:Double>
  <x:Double x:Key="Space3">12</x:Double>
  <x:Double x:Key="Space4">16</x:Double>
  <x:Double x:Key="Space5">20</x:Double>
  <x:Double x:Key="RowHeight">32</x:Double>
  <x:Double x:Key="FieldHeight">40</x:Double>
  <x:Double x:Key="ToolButtonSize">36</x:Double>
  <x:Double x:Key="TitleStripHeight">56</x:Double>
  <x:Double x:Key="StatusBarHeight">40</x:Double>
  <x:Double x:Key="StructureWidth">240</x:Double>
  <x:Double x:Key="InspectorWidth">336</x:Double>
  <Thickness x:Key="PanelPadding">20</Thickness>

  <CornerRadius x:Key="RadiusField">4</CornerRadius>
  <CornerRadius x:Key="RadiusPopover">6</CornerRadius>
  <CornerRadius x:Key="RadiusPill">11</CornerRadius>
</ResourceDictionary>
